exporters:
  exporter_traces_otlp_grpc:
    type:                otlp_grpc
    thread_name:         "OTLP/gRPC trace"
    endpoint:            "http://instana-collector:4317/v1/traces"
    use_ssl_credentials: false

  exporter_metrics_otlp_grpc:
    type:                otlp_grpc
    thread_name:         "OTLP/gRPC metr"
    endpoint:            "http://instana-collector:4317/v1/metrics"
    use_ssl_credentials: false

  exporter_logs_otlp_grpc:
    type:                otlp_grpc
    thread_name:         "OTLP/gRPC logs"
    endpoint:            "http://instana-collector:4317/v1/logs"
    use_ssl_credentials: false

readers:
  reader_metrics:
    thread_name:     "reader metr"
    export_interval: 10000
    export_timeout:  5000

samplers:
  sampler_traces:
    type:     parent_based
    delegate: always_on

processors:
  processor_traces_batch:
    type:                  batch
    thread_name:           "proc/batch trac"
    max_queue_size:        2048
    schedule_delay:        5000
    max_export_batch_size: 512

  processor_logs_batch:
    type:                  batch
    thread_name:           "proc/batch logs"
    max_queue_size:        2048
    schedule_delay:        5000
    max_export_batch_size: 512

providers:
  provider_traces:
    resources:
      - service.version:     "1.0.0"
      - service.instance.id: "${INSTANA_HOST_NAME}-proxy"
      - service.name:        "haproxy-front-proxy"
      - service.namespace:   "HAProxy traces test"
      - host.name:           "${INSTANA_HOST_NAME}"

  provider_metrics:
    resources:
      - service.version:     "1.0.0"
      - service.instance.id: "${INSTANA_HOST_NAME}-proxy"
      - service.name:        "haproxy-front-proxy"
      - service.namespace:   "HAProxy metrics test"
      - host.name:           "${INSTANA_HOST_NAME}"

  provider_logs:
    resources:
      - service.version:     "1.0.0"
      - service.instance.id: "${INSTANA_HOST_NAME}-proxy"
      - service.name:        "haproxy-front-proxy"
      - service.namespace:   "HAProxy logs test"
      - host.name:           "${INSTANA_HOST_NAME}"

signals:
  traces:
    scope_name: "HAProxy OTEL - traces"
    exporters:  exporter_traces_otlp_grpc
    samplers:   sampler_traces
    processors: processor_traces_batch
    providers:  provider_traces

  metrics:
    scope_name: "HAProxy OTEL - metrics"
    exporters:  exporter_metrics_otlp_grpc
    readers:    reader_metrics
    providers:  provider_metrics

  logs:
    scope_name: "HAProxy OTEL - logs"
    exporters:  exporter_logs_otlp_grpc
    processors: processor_logs_batch
    providers:  provider_logs
